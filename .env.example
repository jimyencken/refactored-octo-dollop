# Required for smart chat (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override Claude model (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional: generic OpenAI-compatible LLM (fallback if no Anthropic key)
# LLM_API_KEY=
# LLM_BASE_URL=

# Optional: Web Push notifications (generate with: npx web-push generate-vapid-keys)
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_EMAIL=mailto:you@example.com

# Database (default: SQLite, change for production)
# DATABASE_URL=sqlite+aiosqlite:///./productivity.db

# Server
PORT=8000
TIMEZONE=UTC
